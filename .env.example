# Add variable names and non-secret local defaults here after the services are selected.
# Never commit API keys or real credentials.


# Copy to .env and enter your TomTom key locally. The server reads this value.
API_TOMTOM=

# Optional PostGIS mode. Load migrations and sample data before selecting it.
GIGCA_DATABASE_URL=
GIGCA_AREA_ID=hcmc_demo_point_01

# API v1: fetch data around the driver GPS; no fixture fallback.
GIGCA_DATA_MODE=live
GIGCA_SESSION_DB=.cache/backend.sqlite3

# Docker Compose app (frontend flag requires rebuilding its image).
NEXT_PUBLIC_GIGCA_PREVIEW=false
GIGCA_FRONTEND_PORT=3000

# Optional isolated synthetic demo (restore committed research archives first).
GIGCA_RESEARCH_DEMO=false
# GIGCA_RESEARCH_DATASET=D:/path/to/contextual-seed7
# Optional grounded driver explanations; engine remains usable without LLM.
GIGCA_LLM_EXPLANATIONS=false
GIGCA_LLM_BASE_URL=https://api.shopaikey.com/v1
GIGCA_LLM_API_KEY=
GIGCA_LLM_MODEL=

# Saved model paths (native API vs Docker host bind mount).
GIGCA_MAIN_MODEL_DIR=.cache/models/logistic-hazard-quantile-gb-hcmc
GIGCA_MODEL_HOST_DIR=./.cache/models/logistic-hazard-quantile-gb-hcmc

# Optional Google AI Studio Gemini key (fallback for explanations only).
GIGCA_GEMINI_API_KEY=
GIGCA_GEMINI_MODEL=gemini-3.8-flash

# Experimental POI/time reranking, no change to saved ML weights.
GIGCA_POI_RANKING=true
GIGCA_LIVE_CANDIDATES=true
