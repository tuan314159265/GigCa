{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigca.local/contracts/engine_input.schema.json",
  "title": "GigCa Decision Engine Input Snapshot",
  "description": "Draft normalized input from Data role to Decision Engine; scores and recommendations are out of scope.",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "generated_at", "source_dataset_ids", "data_status", "objective_readiness", "areas", "limitations"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_dataset_ids": {"type": "array", "items": {"type": "string"}},
    "driver_preferences": {
      "type": "object",
      "description": "User-selected preferences. Rain tolerance is an input, not a weather observation; numeric mappings remain to be agreed.",
      "properties": {
        "rain_tolerance_level": {"enum": ["low", "medium", "high"]}
      },
      "additionalProperties": true
    },
    "data_status": {
      "type": "array",
      "description": "Availability per input dataset; the engine must not treat missing data as zero.",
      "items": {
        "type": "object",
        "required": ["dataset", "status", "reason"],
        "properties": {
          "dataset": {"type": "string"},
          "status": {"enum": ["available", "partial", "missing", "stale", "not_integrated"]},
          "reason": {"type": "string"},
          "source_dataset_id": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "objective_readiness": {
      "type": "array",
      "description": "Readiness for each product goal based on the data in this snapshot.",
      "items": {
        "type": "object",
        "required": ["objective", "status", "blocking_datasets", "reason"],
        "properties": {
          "objective": {"enum": ["max_trip_value", "maintain_position", "rest_spot", "safety_comfort"]},
          "status": {"enum": ["available", "partial", "insufficient_data"]},
          "blocking_datasets": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "traffic": {
      "type": "array",
      "description": "Observed provider road segments in Engine TrafficEdge format. Segments are not graph edges unless explicitly matched.",
      "items": {
        "type": "object",
        "required": ["edge_id", "observed_at"],
        "properties": {
          "edge_id": {"type": "string", "minLength": 1, "description": "Stable provider-segment identifier; not necessarily a street name or matched graph edge."},
          "from_node": {"type": ["string", "null"]},
          "to_node": {"type": ["string", "null"]},
          "length_m": {"type": ["number", "null"], "minimum": 0},
          "current_speed_kmh": {"type": ["number", "null"], "minimum": 0},
          "free_flow_speed_kmh": {"type": ["number", "null"], "minimum": 0},
          "congestion_level": {"enum": ["thong_thoang", "dong_xe", "un_tac", null]},
          "observed_at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["area_id", "spatial_scope", "representative_point", "weather", "poi_counts_by_category", "routing_samples"],
        "properties": {
          "area_id": {"type": "string"},
          "spatial_scope": {"enum": ["point_sample", "grid_cell", "polygon"]},
          "representative_point": {"$ref": "#/$defs/coordinate"},
          "weather": {
            "type": "object",
            "required": ["hourly"],
            "properties": {
              "provider_grid_location": {
                "type": "object",
                "required": ["latitude", "longitude"],
                "properties": {
                  "latitude": {"type": "number"},
                  "longitude": {"type": "number"},
                  "elevation_m": {"type": ["number", "null"]}
                },
                "additionalProperties": true
              },
              "hourly": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["valid_time", "precipitation_mm", "precipitation_probability_pct"],
                  "properties": {
                    "valid_time": {"type": "string"},
                    "precipitation_mm": {"type": ["number", "null"]},
                    "precipitation_probability_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "poi_counts_by_category": {
            "type": "object",
            "additionalProperties": {"type": "integer", "minimum": 0}
          },
          "poi_density_grid": {
            "type": "object",
            "required": ["cell_size_m", "cells"],
            "properties": {
              "cell_size_m": {"type": ["integer", "null"], "minimum": 1},
              "source_dataset_id": {"type": ["string", "null"]},
              "cells": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["cell_id", "cell_size_m", "cell_area_km2", "cafe_poi_count", "cafe_density_per_km2", "cafe_poi_count_within_500m", "cafe_count_500m_status", "center", "geometry"],
                  "properties": {
                    "cell_id": {"type": "string"},
                    "row": {"type": "integer", "minimum": 0},
                    "column": {"type": "integer", "minimum": 0},
                    "cell_size_m": {"type": "integer", "minimum": 1},
                    "cell_area_km2": {"type": "number", "minimum": 0},
                    "cafe_poi_count": {"type": "integer", "minimum": 0},
                    "cafe_density_per_km2": {"type": "number", "minimum": 0},
                    "cafe_poi_count_within_500m": {"type": ["integer", "null"], "minimum": 0},
                    "cafe_count_500m_status": {"enum": ["full_coverage", "partial_coverage"]},
                    "center": {"$ref": "#/$defs/coordinate"},
                    "geometry": {"type": "object", "required": ["type", "coordinates"], "properties": {"type": {"const": "Polygon"}, "coordinates": {"type": "array"}}, "additionalProperties": true}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "waiting_location_candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["candidate_id", "poi_type", "role", "candidate_status", "permission_to_wait", "latitude", "longitude", "point_method", "verification_needed"],
              "properties": {
                "candidate_id": {"type": "string"},
                "source_provider": {"type": "string"},
                "source_id": {"type": "string"},
                "osm_type": {"type": "string"},
                "osm_id": {"type": ["integer", "string"]},
                "name": {"type": ["string", "null"]},
                "poi_type": {"type": "string"},
                "role": {"const": "waiting_location_candidate"},
                "candidate_status": {"const": "unverified_candidate"},
                "permission_to_wait": {"const": "unknown"},
                "latitude": {"type": "number", "minimum": -90, "maximum": 90},
                "longitude": {"type": "number", "minimum": -180, "maximum": 180},
                "point_method": {"type": "string"},
                "area_m2": {"type": ["number", "null"], "minimum": 0},
                "verification_needed": {"type": "array", "items": {"type": "string"}},
                "categories": {"type": "array", "items": {"type": "string"}},
                "address": {"type": ["string", "null"]},
                "tags": {"type": "object"}
              },
              "additionalProperties": false
            }
          },
          "routing_samples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["destination_id", "profile", "route_distance_m", "route_duration_s"],
              "properties": {
                "destination_id": {"type": "string"},
                "profile": {"type": "string"},
                "route_distance_m": {"type": ["number", "null"], "minimum": 0},
                "route_duration_s": {"type": ["number", "null"], "minimum": 0}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "coordinate": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
