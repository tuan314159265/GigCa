{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigca.local/contracts/engine_input.schema.json",
  "title": "GigCa Decision Engine Input Snapshot",
  "description": "Draft normalized input from Data role to Decision Engine; scores and recommendations are out of scope.",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "generated_at", "source_dataset_ids", "areas", "limitations"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_dataset_ids": {"type": "array", "items": {"type": "string"}},
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["area_id", "spatial_scope", "representative_point", "weather", "poi_counts_by_category", "routing_samples"],
        "properties": {
          "area_id": {"type": "string"},
          "spatial_scope": {"enum": ["point_sample", "grid_cell", "polygon"]},
          "representative_point": {"$ref": "#/$defs/coordinate"},
          "weather": {
            "type": "object",
            "required": ["hourly"],
            "properties": {
              "provider_grid_location": {
                "type": "object",
                "required": ["latitude", "longitude"],
                "properties": {
                  "latitude": {"type": "number"},
                  "longitude": {"type": "number"},
                  "elevation_m": {"type": ["number", "null"]}
                },
                "additionalProperties": true
              },
              "hourly": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["valid_time", "precipitation_mm", "precipitation_probability_pct", "apparent_temperature_c", "shortwave_radiation_w_m2", "wind_speed_10m_kmh", "wind_gusts_10m_kmh", "weather_code_wmo"],
                  "properties": {
                    "valid_time": {"type": "string"},
                    "precipitation_mm": {"type": ["number", "null"]},
                    "precipitation_probability_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
                    "apparent_temperature_c": {"type": ["number", "null"]},
                    "shortwave_radiation_w_m2": {"type": ["number", "null"]},
                    "wind_speed_10m_kmh": {"type": ["number", "null"]},
                    "wind_gusts_10m_kmh": {"type": ["number", "null"]},
                    "weather_code_wmo": {"type": ["integer", "null"]}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "poi_counts_by_category": {
            "type": "object",
            "additionalProperties": {"type": "integer", "minimum": 0}
          },
          "routing_samples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["destination_id", "profile", "route_distance_m", "route_duration_s"],
              "properties": {
                "destination_id": {"type": "string"},
                "profile": {"type": "string"},
                "route_distance_m": {"type": ["number", "null"], "minimum": 0},
                "route_duration_s": {"type": ["number", "null"], "minimum": 0}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "coordinate": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
